#!/bin/bash
# ───────────────────────────────────────────────────────────────────
# Minimal Bastion Bootstrap (Ansible Ready)
# ───────────────────────────────────────────────────────────────────
# Project URL: ${project_url}
# Env: ${env}
set -e

# 1. Set Hostname
sudo hostnamectl set-hostname "${hostname}"

# 2. System Update & Python
sudo yum update -y
sudo yum install -y python3 python3-pip git

# 3. Custom .bashrc
cat << 'EOF' > /home/ec2-user/.bashrc
${bashrc_content}
EOF
sudo chown ec2-user:ec2-user /home/ec2-user/.bashrc

echo "✅ Minimal bootstrap complete. Handing over to Ansible."

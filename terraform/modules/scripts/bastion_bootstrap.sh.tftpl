#!/bin/bash
# =============================================================================
# Bastion Host Bootstrap Script for Spring Petclinic Microservices
# =============================================================================
# This script configures the bastion host with essential tools and security
# settings for secure access to the private infrastructure.
# =============================================================================

set -e

# Configuration
PROJECT_NAME="spring-petclinic"
ENVIRONMENT="${env}"
HOSTNAME="${hostname}"
LOG_FILE="/var/log/bastion_bootstrap.log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Logging function
log() {
    echo -e "$${GREEN}[$(date '+%Y-%m-%d %H:%M:%S')]$${NC} $1" | tee -a "$LOG_FILE"
}

warn() {
    echo -e "$${YELLOW}[$(date '+%Y-%m-%d %H:%M:%S')] WARNING:$${NC} $1" | tee -a "$LOG_FILE"
}

error() {
    echo -e "$${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ERROR:$${NC} $1" | tee -a "$LOG_FILE"
    exit 1
}

# =============================================================================
# System Update & Security Hardening
# =============================================================================
log "Starting bastion host bootstrap..."
log "Project: $${PROJECT_NAME}"
log "Environment: $${ENVIRONMENT}"
log "Setting hostname to $${HOSTNAME}..."
sudo hostnamectl set-hostname "$${HOSTNAME}"

log "Updating system packages..."
sudo yum update -y || error "Failed to update system packages"

log "Enabling EPEL and extras..."
sudo amazon-linux-extras install epel -y || warn "Failed to install EPEL"
sudo yum install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-7.noarch.rpm || warn "Failed to install EPEL rpm"

log "Installing essential security tools..."
sudo yum install -y \
    fail2ban \
    logrotate \
    audit \
    htop \
    iotop \
    nmap-ncat \
    telnet \
    jq \
    tree \
    vim-enhanced \
    bash-completion \
    || warn "Some security tools installation failed"

# Configure fail2ban
log "Configuring fail2ban..."
sudo systemctl enable fail2ban
sudo systemctl start fail2ban

# =============================================================================
# Docker Installation
# =============================================================================
log "Installing Docker..."

# Install Docker
sudo yum install -y docker
sudo systemctl start docker
sudo systemctl enable docker

# Add ec2-user to docker group
sudo usermod -aG docker ec2-user

log "Docker installed successfully"

# =============================================================================
# AWS CLI Installation
# =============================================================================
log "Installing AWS CLI v2..."

# Check if AWS CLI is already installed
if ! command -v aws &> /dev/null; then
    curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip"
    unzip -q /tmp/awscliv2.zip -d /tmp
    sudo /tmp/aws/install
    rm -rf /tmp/aws /tmp/awscliv2.zip
    log "AWS CLI v2 installed successfully"
else
    log "AWS CLI already installed"
fi

# =============================================================================
# Git Installation
# =============================================================================
log "Installing Git..."

if ! command -v git &> /dev/null; then
    sudo yum install -y git
    log "Git installed successfully"
else
    log "Git already installed"
fi

# =============================================================================
# Terraform Installation
# =============================================================================
log "Installing Terraform..."

if ! command -v terraform &> /dev/null; then
    sudo yum install -y yum-utils
    sudo yum-config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo
    sudo yum -y install terraform
    log "Terraform installed successfully"
else
    log "Terraform already installed"
fi

# =============================================================================
# Terragrunt Installation
# =============================================================================
log "Installing Terragrunt..."

if ! command -v terragrunt &> /dev/null; then
    TERRAGRUNT_VERSION="0.67.0"
    curl -Lo /tmp/terragrunt https://github.com/gruntwork-io/terragrunt/releases/download/v$${TERRAGRUNT_VERSION}/terragrunt_linux_amd64
    chmod +x /tmp/terragrunt
    sudo mv /tmp/terragrunt /usr/local/bin/terragrunt
    log "Terragrunt $${TERRAGRUNT_VERSION} installed successfully"
else
    log "Terragrunt already installed"
fi

# =============================================================================
# Kubernetes Tools Installation
# =============================================================================
log "Installing Kubernetes tools (kubectl, helm)..."

# kubectl
if ! command -v kubectl &> /dev/null; then
    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
    chmod +x kubectl
    sudo mv kubectl /usr/local/bin/
    log "kubectl installed successfully"
else
    log "kubectl already installed"
fi

# helm
if ! command -v helm &> /dev/null; then
    curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
    log "Helm installed successfully"
else
    log "Helm already installed"
fi

# =============================================================================
# SSH Configuration
# =============================================================================
log "Configuring SSH security..."

# Backup SSH config
sudo cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak

# Harden SSH configuration
sudo tee -a /etc/ssh/sshd_config.d/bastion-hardening.conf > /dev/null <<EOF
# Bastion Host SSH Hardening
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
X11Forwarding no
MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 60
EOF

# Restart SSH service
sudo systemctl restart sshd
log "SSH hardened successfully"

# =============================================================================
# Bash Configuration for ec2-user
# =============================================================================
log "Configuring bash environment..."

cat << 'EOF' > /home/ec2-user/.bashrc
${bashrc_content}
EOF

sudo chown ec2-user:ec2-user /home/ec2-user/.bashrc
sudo chmod 644 /home/ec2-user/.bashrc

# =============================================================================
# MOTD (Message of the Day)
# =============================================================================
log "Setting up MOTD..."

sudo tee /etc/motd > /dev/null <<EOF
╔══════════════════════════════════════════════════════════════════════════════╗
║                    Spring Petclinic Microservices                            ║
║                           Bastion Host - $${ENVIRONMENT^^}                              ║
╠══════════════════════════════════════════════════════════════════════════════╣
║  Project: $${PROJECT_NAME}
║  Environment: $${ENVIRONMENT}
║  Hostname: \$(hostname)
║  Private IP: \$(hostname -I | awk '{print \$1}')
╠══════════════════════════════════════════════════════════════════════════════╣
║  Quick Start:                                                                ║
║    • Terraform: cd /opt/spring-petclinic/terraform/live/dev                 ║
║    • Ansible:   cd /opt/spring-petclinic/ansible                            ║
║    • Logs:      journalctl -u docker -f                                     ║
║                                                                              ║
║  Useful Commands:                                                            ║
║    • tf plan / tf apply                                                      ║
║    • kubectl get pods -n petclinic                                           ║
║    • docker ps                                                               ║
╚══════════════════════════════════════════════════════════════════════════════╝
EOF

# =============================================================================
# Directory Structure
# =============================================================================
log "Creating project directory structure..."

sudo mkdir -p /opt/spring-petclinic/{terraform,ansible,scripts,logs}
sudo chown -R ec2-user:ec2-user /opt/spring-petclinic
sudo chmod -R 755 /opt/spring-petclinic

# =============================================================================
# CloudWatch Logs Agent (Optional)
# =============================================================================
log "Installing CloudWatch Logs agent..."

sudo yum install -y amazon-cloudwatch-agent

# Create CloudWatch agent configuration
sudo tee /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json > /dev/null <<EOF
{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/bastion_bootstrap.log",
            "log_group_name": "/spring-petclinic/$${ENVIRONMENT}/bastion",
            "log_stream_name": "{instance_id}/bootstrap"
          },
          {
            "file_path": "/var/log/secure",
            "log_group_name": "/spring-petclinic/$${ENVIRONMENT}/bastion",
            "log_stream_name": "{instance_id}/secure"
          }
        ]
      }
    }
  }
}
EOF

sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s
sudo systemctl enable amazon-cloudwatch-agent
sudo systemctl start amazon-cloudwatch-agent

log "CloudWatch Logs agent configured"

# =============================================================================
# Final Summary
# =============================================================================
log "═══════════════════════════════════════════════════════════════"
log "Bastion Host Bootstrap Completed Successfully!"
log "═══════════════════════════════════════════════════════════════"
log ""
log "Installed Components:"
log "  ✓ Docker"
log "  ✓ AWS CLI v2"
log "  ✓ Git"
log "  ✓ Terraform"
log "  ✓ Terragrunt"
log "  ✓ kubectl"
log "  ✓ helm"
log "  ✓ fail2ban"
log "  ✓ CloudWatch Logs Agent"
log ""
log "Security Hardening:"
log "  ✓ SSH hardened (no root login, key-based auth only)"
log "  ✓ fail2ban enabled"
log "  ✓ Audit logging enabled"
log ""
log "Next Steps:"
log "  1. Copy your SSH key to the bastion:"
log "     scp -i <your-key.pem> <your-key.pem> ec2-user@\$(curl -s http://169.254.169.254/latest/meta-data/public-ipv4):~/.ssh/"
log ""
log "  2. SSH to bastion:"
log "     ssh -i <your-key.pem> ec2-user@\$(curl -s http://169.254.169.254/latest/meta-data/public-ipv4)"
log ""
log "  3. From bastion, SSH to private instances:"
log "     ssh -i ~/.ssh/<your-key.pem> ec2-user@<private-instance-ip>"
log ""
log "  4. Access Terraform configurations:"
log "     cd /opt/spring-petclinic/terraform/live/dev"
log ""
log "═══════════════════════════════════════════════════════════════"
log "Log file: $${LOG_FILE}"
log "═══════════════════════════════════════════════════════════════"

# Reboot to apply all changes
log "Rebooting in 10 seconds to apply all changes..."
sleep 10
sudo reboot

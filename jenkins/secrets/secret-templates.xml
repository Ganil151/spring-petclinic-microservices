<?xml version='1.1' encoding='UTF-8'?>
<!-- Secret Templates for Spring Petclinic Microservices -->
<!-- Defines templates for common secret types used in CI/CD pipelines -->
<secrets>
  
  <!-- Environment Variables Template -->
  <template id="env-vars-template">
    <name>Environment Variables Template</name>
    <description>Common environment variables for Spring Petclinic pipelines</description>
    <variables>
      <variable>
        <key>SPRING_PROFILES_ACTIVE</key>
        <value>default</value>
        <description>Spring active profiles</description>
      </variable>
      <variable>
        <key>DOCKER_REGISTRY</key>
        <value>docker.io</value>
        <description>Docker registry URL</description>
      </variable>
      <variable>
        <key>EKS_CLUSTER_NAME</key>
        <value>spring-petclinic-cluster</value>
        <description>EKS cluster name</description>
      </variable>
      <variable>
        <key>KUBERNETES_NAMESPACE</key>
        <value>spring-petclinic</value>
        <description>Kubernetes namespace</description>
      </variable>
    </variables>
  </template>
  
  <!-- Database Credentials Template -->
  <template id="db-credentials-template">
    <name>Database Credentials Template</name>
    <description>Database connection credentials for microservices</description>
    <credentials>
      <credential type="username-password">
        <id>mysql-credentials</id>
        <description>MySQL Database Credentials</description>
        <username>${DB_USERNAME}</username>
        <password>${DB_PASSWORD}</password>
      </credential>
      <credential type="connection-string">
        <id>mysql-connection</id>
        <description>MySQL Connection String</description>
        <value>jdbc:mysql://${DB_HOST}:3306/petclinic</value>
      </credential>
    </credentials>
  </template>
  
  <!-- API Keys Template -->
  <template id="api-keys-template">
    <name>API Keys Template</name>
    <description>External API keys for integrations</description>
    <keys>
      <key>
        <id>slack-webhook</id>
        <description>Slack Webhook URL for notifications</description>
        <format>url</format>
      </key>
      <key>
        <id>github-token</id>
        <description>GitHub Personal Access Token</description>
        <format>token</format>
      </key>
      <key>
        <id>sonar-token</id>
        <description>SonarQube Authentication Token</description>
        <format>token</format>
      </key>
    </keys>
  </template>
  
  <!-- SSL/TLS Certificates Template -->
  <template id="ssl-certs-template">
    <name>SSL/TLS Certificates Template</name>
    <description>SSL certificates for secure communications</description>
    <certificates>
      <certificate>
        <id>eks-tls-cert</id>
        <description>EKS TLS Certificate</description>
        <type>tls</type>
      </certificate>
      <certificate>
        <id>docker-registry-cert</id>
        <description>Docker Registry SSL Certificate</description>
        <type>tls</type>
      </certificate>
    </certificates>
  </template>
  
</secrets>

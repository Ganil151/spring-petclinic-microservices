<?xml version='1.1' encoding='UTF-8'?>
<!-- Credentials Configuration for Spring Petclinic Microservices -->
<!-- NOTE: Actual secrets should be managed via Jenkins UI or external secret managers -->
<com.cloudbees.plugins.credentials.SystemCredentialsProvider plugin="credentials@2.6.1">
  <domainCredentialsMap class="hudson.util.CopyOnWriteMap$Hash">
    <entry>
      <com.cloudbees.plugins.credentials.domains.Domain>
        <specifications/>
      </com.cloudbees.plugins.credentials.domains.Domain>
      <credentials class="java.util.concurrent.CopyOnWriteArrayList">
        
        <!-- AWS Credentials Template -->
        <com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>
          <scope>GLOBAL</scope>
          <id>aws-credentials</id>
          <description>AWS Credentials for EKS Deployment</description>
          <username>${AWS_ACCESS_KEY_ID}</username>
          <password>${AWS_SECRET_ACCESS_KEY}</password>
        </com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>
        
        <!-- Docker Registry Credentials Template -->
        <com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>
          <scope>GLOBAL</scope>
          <id>docker-registry-credentials</id>
          <description>Docker Registry Credentials</description>
          <username>${DOCKER_USERNAME}</username>
          <password>${DOCKER_PASSWORD}</password>
        </com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl>
        
        <!-- GitHub Token Template -->
        <com.cloudbees.jenkins.plugins.sshcredentials.impl.BasicSSHUserPrivateKey plugin="ssh-credentials@3.0.0">
          <scope>GLOBAL</scope>
          <id>github-ssh-key</id>
          <description>GitHub SSH Key</description>
          <username>git</username>
        </com.cloudbees.jenkins.plugins.sshcredentials.impl.BasicSSHUserPrivateKey>
        
        <!-- SonarQube Token Template -->
        <org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl plugin="plain-credentials@1.79">
          <scope>GLOBAL</scope>
          <id>sonarqube-token</id>
          <description>SonarQube Authentication Token</description>
          <secret>${SONAR_TOKEN}</secret>
        </org.jenkinsci.plugins.plaincredentials.impl.StringCredentialsImpl>
        
        <!-- Kubernetes Config Template -->
        <org.jenkinsci.plugins.kubernetes.credentials.FileCredentialImpl plugin="kubernetes-credentials@0.11.0">
          <scope>GLOBAL</scope>
          <id>kubeconfig</id>
          <description>Kubernetes Configuration</description>
          <fileName>kubeconfig</fileName>
        </org.jenkinsci.plugins.kubernetes.credentials.FileCredentialImpl>
        
      </credentials>
    </entry>
  </domainCredentialsMap>
</com.cloudbees.plugins.credentials.SystemCredentialsProvider>

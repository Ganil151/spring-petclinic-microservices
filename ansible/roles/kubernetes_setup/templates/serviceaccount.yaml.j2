{# =============================================================================
   ServiceAccount Template with IRSA Annotations
   Location: ansible/roles/kubernetes_setup/templates/serviceaccount.yaml.j2
   Purpose: Enable IAM Roles for Service Accounts (IRSA) for AWS access
   ============================================================================= #}
{# Variables expected:
   - default_namespace: Target namespace
   - oidc_provider_arn: IAM OIDC provider ARN (from Terragrunt outputs)
   - oidc_provider_enabled: Boolean flag for IRSA
#}
{% if oidc_provider_enabled | default(true) %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: petclinic-sa
  namespace: {{ default_namespace | default('petclinic') }}
  annotations:
    eks.amazonaws.com/role-arn: "{{ oidc_provider_arn }}"
  labels:
    app.kubernetes.io/name: spring-petclinic
    app.kubernetes.io/component: service-account
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: petclinic-role
  namespace: {{ default_namespace | default('petclinic') }}
rules:
  - apiGroups: [""]
    resources: ["configmaps", "secrets"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["pods", "services"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: petclinic-rolebinding
  namespace: {{ default_namespace | default('petclinic') }}
subjects:
  - kind: ServiceAccount
    name: petclinic-sa
    namespace: {{ default_namespace | default('petclinic') }}
roleRef:
  kind: Role
  name: petclinic-role
  apiGroup: rbac.authorization.k8s.io
{% else %}
# IRSA disabled - using node instance role
apiVersion: v1
kind: ServiceAccount
metadata:
  name: petclinic-sa
  namespace: {{ default_namespace | default('petclinic') }}
  labels:
    app.kubernetes.io/name: spring-petclinic
{% endif %}
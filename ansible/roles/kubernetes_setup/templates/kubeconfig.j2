{# =============================================================================
   Kubeconfig Template for EKS Cluster
   Location: ansible/roles/kubernetes_setup/templates/kubeconfig.j2
   Purpose: Generate kubectl configuration with EKS authentication
   ============================================================================= 
#}
{# Variables expected:
   - eks_cluster_name: Name of the EKS cluster
   - aws_region: AWS region (default: us-east-1)
   - eks_cluster_endpoint: API server endpoint (from Terragrunt outputs)
   - eks_cluster_ca_certificate: Base64-encoded CA cert (from Terragrunt outputs)
#}
apiVersion: v1
kind: Config
preferences: {}
clusters:
  - cluster:
      server: {{ eks_cluster_endpoint }}
      certificate-authority-data: {{ eks_cluster_ca_certificate }}
    name: {{ eks_cluster_name }}
contexts:
  - context:
      cluster: {{ eks_cluster_name }}
      user: eks-user-{{ aws_region }}
      namespace: {{ default_namespace | default('petclinic') }}
    name: {{ eks_cluster_name }}
current-context: {{ eks_cluster_name }}
users:
  - name: eks-user-{{ aws_region }}
    user:
      exec:
        apiVersion: client.authentication.k8s.io/v1beta1
        command: aws
        args:
          - eks
          - get-token
          - --cluster-name
          - {{ eks_cluster_name }}
          - --region
          - {{ aws_region }}
        env: null
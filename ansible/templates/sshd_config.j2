# =============================================================================
# SSH Daemon Configuration Template
# Location: ansible/templates/sshd_config.j2
# Purpose: Secure SSH configuration for Spring Petclinic infrastructure
# Compliance: CIS Amazon Linux 2 Benchmark v1.2.0
# Generated by: Ansible Jinja2 Template
# =============================================================================
#
# This file is managed by Ansible. Manual changes will be overwritten.
# Last updated: {{ ansible_date_time.iso8601 | default('unknown') }}
# Environment: {{ environment | default('dev') }}
# Host: {{ inventory_hostname }}
#
# =============================================================================

# -----------------------------------------------------------------------------
# SSH Protocol & Port Configuration
# -----------------------------------------------------------------------------
# Only use SSH Protocol 2 (Protocol 1 is insecure)
Protocol 2

# SSH listening port (customize for security through obscurity if needed)
Port {{ ssh_hardening.port | default(22) }}

# Address family (inet = IPv4 only, inet6 = IPv6, any = both)
AddressFamily {{ ssh_hardening.address_family | default('any') }}

# Listen on all interfaces (restrict to specific IPs in production)
ListenAddress {{ ssh_hardening.listen_address | default('0.0.0.0') }}

# -----------------------------------------------------------------------------
# Host Keys
# -----------------------------------------------------------------------------
# Host keys for server authentication
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# -----------------------------------------------------------------------------
# Logging & Auditing
# -----------------------------------------------------------------------------
# Logging level (INFO, VERBOSE, DEBUG, etc.)
LogLevel {{ ssh_hardening.log_level | default('INFO') }}

# Syslog facility for SSH logs
SyslogFacility {{ ssh_hardening.syslog_facility | default('AUTH') }}

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Disable root login (CIS 5.2.2)
PermitRootLogin {{ ssh_hardening.permit_root_login | default('no') }}

# Disable password authentication - use keys only (CIS 5.2.1)
PasswordAuthentication {{ ssh_hardening.password_authentication | default('no') }}

# Enable public key authentication
PubkeyAuthentication {{ ssh_hardening.pubkey_authentication | default('yes') }}

# Disable challenge-response authentication (CIS 5.2.4)
ChallengeResponseAuthentication {{ ssh_hardening.challenge_response_authentication | default('no') }}

# Disable host-based authentication
HostbasedAuthentication no

# Ignore .rhosts files
IgnoreRhosts yes

# Ignore user-known hosts for host-based authentication
IgnoreUserKnownHosts yes

# Disable empty passwords (CIS 5.2.5)
PermitEmptyPasswords {{ ssh_hardening.permit_empty_passwords | default('no') }}

# Disable user environment processing (CIS 5.2.16)
PermitUserEnvironment {{ ssh_hardening.permit_user_environment | default('no') }}

# Enable PAM authentication
UsePAM {{ ssh_hardening.use_pam | default('yes') }}

# Kerberos authentication (disabled by default)
KerberosAuthentication no
KerberosOrLocalPasswd no
KerberosTicketCleanup yes
KerberosGetAFSToken no

# GSSAPI authentication (disabled by default)
GSSAPIAuthentication no
GSSAPICleanupCredentials yes

# -----------------------------------------------------------------------------
# Session & Connection Limits
# -----------------------------------------------------------------------------
# Maximum authentication attempts per connection (CIS 5.2.7)
MaxAuthTries {{ ssh_hardening.max_auth_tries | default(3) }}

# Maximum concurrent sessions per connection (CIS 5.2.8)
MaxSessions {{ ssh_hardening.max_sessions | default(10) }}

# Login grace time (time to complete authentication)
LoginGraceTime {{ ssh_hardening.login_grace_time | default(60) }}

# Client alive interval (seconds between keepalive messages)
ClientAliveInterval {{ ssh_hardening.client_alive_interval | default(300) }}

# Maximum number of client alive messages before disconnect
ClientAliveCountMax {{ ssh_hardening.client_alive_count_max | default(2) }}

# -----------------------------------------------------------------------------
# Forwarding & Tunneling
# -----------------------------------------------------------------------------
# Disable X11 forwarding (CIS 5.2.13)
X11Forwarding {{ ssh_hardening.x11_forwarding | default('no') }}

# Disable TCP forwarding (CIS 5.2.14)
AllowTcpForwarding {{ ssh_hardening.allow_tcp_forwarding | default('no') }}

# Disable agent forwarding (CIS 5.2.15)
AllowAgentForwarding {{ ssh_hardening.allow_agent_forwarding | default('no') }}

# Disable tunnel device forwarding
PermitTunnel no

# Gateway ports (disable port forwarding to remote hosts)
GatewayPorts no

# -----------------------------------------------------------------------------
# Banner & MOTD
# -----------------------------------------------------------------------------
# Display security banner before authentication
Banner {{ ssh_hardening.banner_path | default('/etc/ssh/banner') }}

# Print message of the day (disable to prevent information leakage)
PrintMotd {{ ssh_hardening.print_motd | default('no') }}

# Print last log information
PrintLastLog yes

# -----------------------------------------------------------------------------
# Environment & Compression
# -----------------------------------------------------------------------------
# Accept environment variables (restrict to safe variables only)
AcceptEnv {{ ssh_hardening.accept_env | default('LANG LC_*') }}

# Compression settings (delayed = compress after authentication)
Compression {{ ssh_hardening.compression | default('delayed') }}

# TCP keep-alive settings
TCPKeepAlive {{ ssh_hardening.tcp_keep_alive | default('yes') }}

# -----------------------------------------------------------------------------
# DNS & Hostname Verification
# -----------------------------------------------------------------------------
# Disable DNS lookup (speeds up connections, prevents DNS spoofing)
UseDNS {{ ssh_hardening.use_dns | default('no') }}

# Strict host key checking
StrictModes yes

# -----------------------------------------------------------------------------
# Subsystem Configuration
# -----------------------------------------------------------------------------
# SFTP subsystem configuration
Subsystem {{ ssh_hardening.subsystem | default('sftp /usr/libexec/openssh/sftp-server') }}

# -----------------------------------------------------------------------------
# Access Control (Allow/Deny Users & Groups)
# -----------------------------------------------------------------------------
{% if ssh_hardening.allow_users is defined and ssh_hardening.allow_users | length > 0 %}
# Allowed users (whitelist)
AllowUsers {{ ssh_hardening.allow_users | join(' ') }}
{% endif %}

{% if ssh_hardening.allow_groups is defined and ssh_hardening.allow_groups | length > 0 %}
# Allowed groups (whitelist)
AllowGroups {{ ssh_hardening.allow_groups | join(' ') }}
{% endif %}

{% if ssh_hardening.deny_users is defined and ssh_hardening.deny_users | length > 0 %}
# Denied users (blacklist)
DenyUsers {{ ssh_hardening.deny_users | join(' ') }}
{% endif %}

{% if ssh_hardening.deny_groups is defined and ssh_hardening.deny_groups | length > 0 %}
# Denied groups (blacklist)
DenyGroups {{ ssh_hardening.deny_groups | join(' ') }}
{% endif %}

# -----------------------------------------------------------------------------
# Cryptographic Settings (CIS 5.2.17 - 5.2.20)
# -----------------------------------------------------------------------------
# Strong key exchange algorithms only
{% if ssh_hardening.kex_algorithms is defined %}
KexAlgorithms {{ ssh_hardening.kex_algorithms | join(',') }}
{% else %}
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
{% endif %}

# Strong ciphers only (no weak ciphers like 3DES, Blowfish, RC4)
{% if ssh_hardening.ciphers is defined %}
Ciphers {{ ssh_hardening.ciphers | join(',') }}
{% else %}
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
{% endif %}

# Strong MACs only (no weak MACs like MD5, SHA1)
{% if ssh_hardening.macs is defined %}
MACs {{ ssh_hardening.macs | join(',') }}
{% else %}
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
{% endif %}

# Strong host key algorithms only
{% if ssh_hardening.host_key_algorithms is defined %}
HostKeyAlgorithms {{ ssh_hardening.host_key_algorithms | join(',') }}
{% else %}
HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-512-cert-v01@openssh.com,rsa-sha2-256,rsa-sha2-256-cert-v01@openssh.com
{% endif %}

# -----------------------------------------------------------------------------
# Match Blocks for Specific Users/Groups (Optional)
# -----------------------------------------------------------------------------
{% if ssh_hardening.match_blocks is defined and ssh_hardening.match_blocks | length > 0 %}
{% for match_block in ssh_hardening.match_blocks %}
Match {{ match_block.criteria }}
{% for key, value in match_block.settings.items() %}
    {{ key }} {{ value }}
{% endfor %}

{% endfor %}
{% endif %}

# -----------------------------------------------------------------------------
# Environment-Specific Overrides
# -----------------------------------------------------------------------------
{% if environment | default('dev') == 'prod' %}
# Production-specific hardening
MaxAuthTries 2
LoginGraceTime 30
ClientAliveInterval 180
ClientAliveCountMax 1
{% elif environment | default('dev') == 'staging' %}
# Staging-specific settings (slightly more relaxed than prod)
MaxAuthTries 3
LoginGraceTime 45
{% endif %}

